# Core app inputs used by FastAPI and the local sample dataset loader.
SAMPLE_CORPUS_MANIFEST=sample_corpus/manifest.json
SAMPLE_USERS_FILE=sample_requests/users.json
SAMPLE_QUERIES_FILE=sample_requests/queries.json
SAMPLE_EXPECTED_BEHAVIORS_FILE=sample_requests/expected_behaviors.json

# Retrieval / execution mode switches used at runtime.
# RETRIEVAL_BACKEND: "memory" for the local fake backend or "opensearch" for the real backend.
# RAG_GRAPH_BACKEND: "fsm" for the deterministic implementation or "langgraph" for the real graph runtime.
RETRIEVAL_BACKEND=memory
RAG_GRAPH_BACKEND=fsm
MODEL_ROUTING_MODE=deterministic

# OpenSearch connection and index settings used by the real backend.
# Keep real OpenSearch credentials out of this file.
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=tax-rag-chunks-v1
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# AWS / Bedrock runtime settings used by optional live integrations.
# Keep real AWS credentials out of this file. Use AWS profiles, IAM roles, SSO,
# or environment-specific secret managers.
AWS_REGION=eu-central-1
BEDROCK_REGION=eu-central-1
AWS_PROFILE=tax-rag-dev
BEDROCK_GENERATION_MODEL_ID=eu.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_FAST_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_JUDGE_MODEL_ID=eu.anthropic.claude-3-7-sonnet-20250219-v1:0
BEDROCK_EMBEDDING_MODEL_ID=eu.cohere.embed-v4:0
BEDROCK_FALLBACK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
BEDROCK_RERANK_INFERENCE_PROFILE_ID=
BEDROCK_EMBEDDINGS_ENABLED=false
BEDROCK_RERANK_ENABLED=false
BEDROCK_GENERATION_ENABLED=false

# Semantic cache settings used by RagService/cache backends.
REDIS_URL=redis://redis:6379/0
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_BACKEND=memory
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_SAFE_THRESHOLD=0.95

# Retrieval tuning used directly by the retrieval layer.
RETRIEVAL_LEXICAL_TOP_K=50
RETRIEVAL_VECTOR_TOP_K=50
RETRIEVAL_FUSED_CANDIDATES=80
RERANK_MAX_CANDIDATES=60
FINAL_CONTEXT_CHUNKS=8
HNSW_M=32
HNSW_EF_CONSTRUCTION=256
HNSW_EF_SEARCH=128

# Optional Langfuse configuration for future observability integration.
# Replace example values in your local .env only if/when you enable Langfuse.
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Never commit real secrets such as AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY.




